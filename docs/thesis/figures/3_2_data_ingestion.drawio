    <!-- csv_to_sql.py -->
    <mxCell id="200" value="&lt;b&gt;csv_to_sql.py&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px;&apos; color=&apos;#475569&apos;&gt;• stream CSV (1 pass)&lt;br&gt;• deduplicate by name&lt;br&gt;• keep first-seen coords&lt;br&gt;• warn if coords drift &gt; 1e-5°&lt;br&gt;• sort by name → assign id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=10;arcSize=8;verticalAlign=middle;" vertex="1" parent="1">
